rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Admin panel + POS app log in with this account.
    // Shop customers also have Firebase Auth accounts now, so "logged in" is no longer enough.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'el.cuartito.cph@gmail.com';
    }

    match /receipts/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /Contabilidad/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
